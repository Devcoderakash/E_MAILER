// MailPilot Prisma Schema
// Configured for Supabase PostgreSQL with Connection Pooling (Transaction Pooler + Direct URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum ContactSource {
  MANUAL
  CSV
  API
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TemplateCategory {
  MARKETING
  NEWSLETTER
  TRANSACTIONAL
  WELCOME
  PROMOTIONAL
  CUSTOM
}

enum TemplateStatus {
  DRAFT
  READY
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SCHEDULED
  SENDING
  SENT
  PAUSED
  FAILED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
  DELIVERED
  BOUNCED
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  DELIVERY_DELAYED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

// Foundation User model linked to Supabase Auth UUID
model User {
  id                String     @id @default(uuid())
  supabaseId        String     @unique @map("supabase_id")
  email             String     @unique
  name              String?
  role              String     @default("member")
  activeWorkspaceId String?    @map("active_workspace_id")
  activeWorkspace   Workspace? @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]

  @@map("users")
}

// Workspace Organization unit for multi-tenancy
model Workspace {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  ownerId              String   @map("owner_id")
  owner                User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  defaultEmailProvider String?  @default("GMAIL_SMTP") @map("default_email_provider")

  members              WorkspaceMember[]
  activeUsers          User[]                    @relation("UserActiveWorkspace")
  contacts             Contact[]
  contactLists         ContactList[]
  contactTags          ContactTag[]
  importJobs           ImportJob[]
  emailTemplates       EmailTemplate[]
  campaigns            Campaign[]
  emailEvents          EmailEvent[]
  automations          Automation[]
  automationExecutions AutomationExecution[]
  smtpConfig           WorkspaceSmtpConfig?
  googleCalendar       GoogleCalendarConnection?

  @@map("workspaces")
}

// Workspace Member relationship with role-based access control
model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // owner, admin, member
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// Contact Model
model Contact {
  id           String        @id @default(uuid())
  workspaceId  String        @map("workspace_id")
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  firstName    String?       @map("first_name")
  lastName     String?       @map("last_name")
  phone        String?
  company      String?
  status       ContactStatus @default(ACTIVE)
  source       ContactSource @default(MANUAL)
  customFields Json?         @map("custom_fields")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  listMemberships      ContactListMember[]
  tagAssignments       ContactTagAssignment[]
  campaignRecipients   CampaignRecipient[]
  emailEvents          EmailEvent[]
  automationExecutions AutomationExecution[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@map("contacts")
}

// Contact List for Audience Segments
model ContactList {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  members ContactListMember[]

  @@unique([workspaceId, name])
  @@map("contact_lists")
}

// Contact List Membership
model ContactListMember {
  id        String      @id @default(uuid())
  contactId String      @map("contact_id")
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  listId    String      @map("list_id")
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([contactId, listId])
  @@map("contact_list_members")
}

// Contact Tag
model ContactTag {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String    @default("#4f46e5")
  createdAt   DateTime  @default(now()) @map("created_at")

  assignments ContactTagAssignment[]

  @@unique([workspaceId, name])
  @@map("contact_tags")
}

// Contact Tag Assignment
model ContactTagAssignment {
  id        String     @id @default(uuid())
  contactId String     @map("contact_id")
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String     @map("tag_id")
  tag       ContactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@map("contact_tag_assignments")
}

// CSV Batch Import Job Tracker
model ImportJob {
  id           String          @id @default(uuid())
  workspaceId  String          @map("workspace_id")
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName     String          @map("file_name")
  totalRows    Int             @default(0) @map("total_rows")
  importedRows Int             @default(0) @map("imported_rows")
  skippedRows  Int             @default(0) @map("skipped_rows")
  failedRows   Int             @default(0) @map("failed_rows")
  status       ImportJobStatus @default(PENDING)
  errorReport  Json?           @map("error_report")
  createdAt    DateTime        @default(now()) @map("created_at")
  completedAt  DateTime?       @map("completed_at")

  @@map("import_jobs")
}

// System setting / health check record
model SystemHealth {
  id        String   @id @default(uuid())
  service   String   @unique
  status    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_health")
}

// Email Template Model for Email Template Studio
model EmailTemplate {
  id            String           @id @default(uuid())
  workspaceId   String           @map("workspace_id")
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  category      TemplateCategory @default(MARKETING)
  subject       String?
  preheader     String?
  htmlContent   String           @map("html_content") @db.Text
  editorContent Json?            @map("editor_content")
  status        TemplateStatus   @default(DRAFT)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@map("email_templates")
}

// Campaign Model for Campaign Manager & Email Engine
model Campaign {
  id                     String         @id @default(uuid())
  workspaceId            String         @map("workspace_id")
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                   String
  subject                String
  preheader              String?
  fromName               String         @map("from_name")
  fromEmail              String         @map("from_email")
  replyTo                String?        @map("reply_to")
  templateId             String?        @map("template_id")
  template               EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  htmlContent            String         @map("html_content") @db.Text
  status                 CampaignStatus @default(DRAFT)
  provider               String?        @default("GMAIL_SMTP")
  targetListIds          String[]       @default([]) @map("target_list_ids")
  targetTagIds           String[]       @default([]) @map("target_tag_ids")
  recipientCount         Int            @default(0) @map("recipient_count")
  sentCount              Int            @default(0) @map("sent_count")
  failedCount            Int            @default(0) @map("failed_count")
  deliveredCount         Int            @default(0) @map("delivered_count")
  openedCount            Int            @default(0) @map("opened_count")
  clickedCount           Int            @default(0) @map("clicked_count")
  bouncedCount           Int            @default(0) @map("bounced_count")
  complainedCount        Int            @default(0) @map("complained_count")
  unsubscribedCount      Int            @default(0) @map("unsubscribed_count")
  scheduledAt            DateTime?      @map("scheduled_at")
  scheduledTimezone      String?        @map("scheduled_timezone")
  scheduledJobId         String?        @map("scheduled_job_id")
  lastScheduledAt        DateTime?      @map("last_scheduled_at")
  schedulingError        String?        @map("scheduling_error")
  googleCalendarEventId  String?        @map("google_calendar_event_id")
  googleCalendarSyncedAt DateTime?      @map("google_calendar_synced_at")
  startedAt              DateTime?      @map("started_at")
  completedAt            DateTime?      @map("completed_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  recipients  CampaignRecipient[]
  emailEvents EmailEvent[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@map("campaigns")
}

// Campaign Recipient Snapshot & Delivery Log
model CampaignRecipient {
  id                String                  @id @default(uuid())
  campaignId        String                  @map("campaign_id")
  campaign          Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String?                 @map("contact_id")
  contact           Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  email             String
  firstName         String?                 @map("first_name")
  lastName          String?                 @map("last_name")
  status            CampaignRecipientStatus @default(PENDING)
  provider          String?                 @default("GMAIL_SMTP")
  attempts          Int                     @default(0)
  errorMessage      String?                 @map("error_message")
  sentAt            DateTime?               @map("sent_at")
  deliveredAt       DateTime?               @map("delivered_at")
  openedAt          DateTime?               @map("opened_at")
  clickedAt         DateTime?               @map("clicked_at")
  bouncedAt         DateTime?               @map("bounced_at")
  providerMessageId String?                 @map("provider_message_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  emailEvents EmailEvent[]

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([providerMessageId])
  @@map("campaign_recipients")
}

// Email Event Model for Webhooks & Analytics
model EmailEvent {
  id                  String            @id @default(uuid())
  workspaceId         String            @map("workspace_id")
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId          String            @map("campaign_id")
  campaign            Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignRecipientId String            @map("campaign_recipient_id")
  campaignRecipient   CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)
  contactId           String?           @map("contact_id")
  contact             Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  provider            String            @default("GMAIL_SMTP")
  providerEventId     String            @map("provider_event_id")
  eventType           EmailEventType    @map("event_type")
  occurredAt          DateTime          @map("occurred_at")
  metadata            Json?             @map("metadata")
  createdAt           DateTime          @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([workspaceId, occurredAt])
  @@index([campaignId, eventType])
  @@index([campaignRecipientId, eventType])
  @@index([contactId])
  @@map("email_events")
}

// Automation Workflow Model
model Automation {
  id                 String           @id @default(uuid())
  workspaceId        String           @map("workspace_id")
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  status             AutomationStatus @default(DRAFT)
  triggerType        String           @map("trigger_type") // CONTACT_SUBSCRIBED, LIST_MEMBER_ADDED, TAG_ASSIGNED, etc.
  workflowDefinition Json             @map("workflow_definition") // { nodes: [], edges: [] }
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  activatedAt        DateTime?        @map("activated_at")

  executions AutomationExecution[]

  @@index([workspaceId, status])
  @@index([workspaceId, triggerType])
  @@map("automations")
}

// Automation Execution Run per Contact
model AutomationExecution {
  id            String                    @id @default(uuid())
  workspaceId   String                    @map("workspace_id")
  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationId  String                    @map("automation_id")
  automation    Automation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId     String                    @map("contact_id")
  contact       Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status        AutomationExecutionStatus @default(RUNNING)
  currentNodeId String?                   @map("current_node_id")
  startedAt     DateTime                  @default(now()) @map("started_at")
  completedAt   DateTime?                 @map("completed_at")
  errorMessage  String?                   @map("error_message")
  contextData   Json?                     @map("context_data")

  stepExecutions AutomationStepExecution[]

  @@index([workspaceId, status])
  @@index([automationId, status])
  @@index([contactId])
  @@map("automation_executions")
}

// Step-level audit log and state tracker
model AutomationStepExecution {
  id           String               @id @default(uuid())
  executionId  String               @map("execution_id")
  execution    AutomationExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId       String               @map("node_id")
  nodeType     String               @map("node_type")
  status       AutomationStepStatus @default(COMPLETED)
  scheduledAt  DateTime?            @map("scheduled_at")
  completedAt  DateTime?            @map("completed_at")
  result       Json?                @map("result")
  errorMessage String?              @map("error_message")
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([executionId])
  @@index([nodeId])
  @@map("automation_step_executions")
}

// Workspace Gmail SMTP Settings
model WorkspaceSmtpConfig {
  id                String    @id @default(uuid())
  workspaceId       String    @unique @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              String // gmail email address
  encryptedPassword String    @map("encrypted_password") // AES-256-GCM encrypted App Password
  host              String    @default("smtp.gmail.com")
  port              Int       @default(587)
  secure            Boolean   @default(false)
  senderName        String    @default("MailPilot") @map("sender_name")
  replyTo           String?   @map("reply_to")
  isVerified        Boolean   @default(false) @map("is_verified")
  lastVerifiedAt    DateTime? @map("last_verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("workspace_smtp_configs")
}

// Google Calendar OAuth & Synchronization
model GoogleCalendarConnection {
  id                    String    @id @default(uuid())
  workspaceId           String    @unique @map("workspace_id")
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  googleEmail           String    @map("google_email")
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenExpiry           DateTime  @map("token_expiry")
  calendarId            String    @default("primary") @map("calendar_id")
  scope                 String    @default("https://www.googleapis.com/auth/calendar.events")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  events GoogleCalendarEvent[]

  @@map("google_calendar_connections")
}

model GoogleCalendarEvent {
  id            String                   @id @default(uuid())
  connectionId  String                   @map("connection_id")
  connection    GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  campaignId    String                   @unique @map("campaign_id")
  googleEventId String                   @map("google_event_id")
  calendarId    String                   @default("primary") @map("calendar_id")
  syncedAt      DateTime                 @default(now()) @map("synced_at")

  @@map("google_calendar_events")
}
