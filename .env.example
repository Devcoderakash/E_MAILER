# MailPilot Environment Variables Configuration
# ===============================================
# Copy this file to .env before starting the development environment.
# DO NOT commit real secrets to source control.

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Supabase (PostgreSQL via Transaction Connection Pooler & Direct Connection)
# DATABASE_URL: Transaction pooler connection string (Port 6543) used by Prisma
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct session connection string (Port 5432) used for Prisma migrations
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth & API Configuration
SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_PUBLISHABLE_KEY (anon key): Safe for client-side frontend use
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
# SUPABASE_SECRET_KEY (service_role key): Highly privileged, BACKEND ONLY - NEVER expose to web
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key

# Redis Configuration (BullMQ & Caching)
REDIS_URL=redis://127.0.0.1:6379

# Email Provider (Resend)
RESEND_API_KEY=re_123456789_abcdefg
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Email Provider (Brevo)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME="MailPilot"
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret_token

# Default Delivery Provider (RESEND or BREVO)
DEFAULT_EMAIL_PROVIDER=RESEND

