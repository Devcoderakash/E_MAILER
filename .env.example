# MailPilot Environment Variables Configuration
# ===============================================
# Copy this file to .env before starting the development environment.
# DO NOT commit real secrets to source control.

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public-facing HTTPS API Base URL for RFC 8058 List-Unsubscribe headers & webhooks
# Required in production (e.g. https://api.yourdomain.com). In local dev, falls back to http://localhost:4000
PUBLIC_API_URL=

# Database & Supabase (PostgreSQL via Transaction Connection Pooler & Direct Connection)
# DATABASE_URL: Transaction pooler connection string (Port 6543) used by Prisma
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct session connection string (Port 5432) used for Prisma migrations
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth & API Configuration
SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_PUBLISHABLE_KEY (anon key): Safe for client-side frontend use
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
# SUPABASE_SECRET_KEY (service_role key): Highly privileged, BACKEND ONLY - NEVER expose to web
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key

# Redis Configuration (BullMQ & Caching)
REDIS_URL=redis://127.0.0.1:6379

# Google Ecosystem Integrations
# -----------------------------
# 1. Gmail SMTP Delivery Provider (Nodemailer)
# Use your Google Account email and 16-character Google App Password (with 2FA enabled)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_SENDER_NAME=MailPilot

# 2. Google Gemini AI (@google/genai)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=

# 3. Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 4. Token Encryption Key (AES-256-GCM 32-byte secret)
TOKEN_ENCRYPTION_KEY=
